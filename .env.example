# 먹보기 설치 설정 예시.
# install.sh 로 설치하면 이 형식의 .env 를 무작위 비밀값과 함께 만들어 주므로 직접 쓸 필요가 없습니다.
# 손으로 설치할 때만 이 파일을 .env 로 복사해 값을 채우세요. 값을 바꾼 뒤에는:
#   docker compose up -d --build

# ---- 주소 -------------------------------------------------------------------
APP_SCHEME=https
APP_HOST=meokbogi.example.com
# 호스트에 열 포트 (웹, API)
WEB_PORT=3003
API_PORT=3004

# 브라우저가 보는 주소. PUBLIC_API_ORIGIN 은 웹을 빌드할 때 번들에 들어가므로,
# 바꾸면 웹 이미지를 다시 빌드해야 합니다 (--build).
PUBLIC_WEB_ORIGIN=https://meokbogi.example.com:3003
PUBLIC_API_ORIGIN=https://meokbogi.example.com:3004

# ---- API (Django) -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=meokbogi_api.settings.product
# 50자 이상 무작위 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# 쉼표로 구분. APP_HOST 와, 서버 안에서 확인할 때 쓰는 localhost
DJANGO_ALLOWED_HOSTS=meokbogi.example.com,localhost,127.0.0.1
# 웹 주소 (PUBLIC_WEB_ORIGIN 과 같게). 쉼표로 여러 개
CORS_ALLOWED_ORIGINS=https://meokbogi.example.com:3003

# 로그인 유지 쿠키. install.sh 와 같은 기준:
#   https → SAMESITE=None, SECURE=true
#   http  → SAMESITE=Lax,  SECURE=false (http에서 true면 브라우저가 쿠키를 버려 자동로그인이 안 됩니다)
REFRESH_COOKIE_SAMESITE=None
REFRESH_COOKIE_SECURE=true

# ---- 알림 -------------------------------------------------------------------
# 알림 보내기 API(POST /push/send)의 토큰. 헤더 Authorization: Bearer <이 값>
# 비워 두면 /push/send 는 503으로 막힙니다.
PUSH_API_TOKEN=change-me
# (선택) 푸시 서명 키. 비워 두면 처음 쓸 때 만들어 DB에 저장합니다.
# VAPID_PRIVATE_KEY=
# (선택) 푸시 서명의 연락처. mailto: 또는 https: 주소. 비워 두면 PUBLIC_WEB_ORIGIN(https일 때)을 씁니다.
# VAPID_SUBJECT=mailto:me@example.com

# ---- DB (PostgreSQL) --------------------------------------------------------
DB_NAME=meokbogi
DB_USER=meokbogi
DB_PASSWORD=change-me
# compose 안의 postgres 서비스 이름과 포트
DB_HOST=postgres
DB_PORT=5432

# ---- docker compose ---------------------------------------------------------
# 서비스들이 붙는 네트워크 이름
NETWORK_NAME=meokbogi
# 컨테이너·볼륨·네트워크 이름의 접두사. 같은 서버의 다른 스택과 섞이지 않게 합니다.
COMPOSE_PROJECT_NAME=meokbogi

# ---- (선택) 내정보의 버전 표기 ---------------------------------------------
# 릴리즈 이미지에는 빌드 때 들어갑니다. 여기서 주면 이쪽이 우선합니다.
# APP_VERSION=2.1.0
# APP_RELEASE_DATE=2026-10-02
# APP_LAST_UPDATED_AT=2026-10-02
